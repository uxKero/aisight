{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AISight",
  "version": "0.1.0",
  "identifier": "com.uxkero.aisight",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4890",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AISight",
        "width": 1180,
        "height": 740,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "windowEffects": { "effects": ["tabbedLight"] },
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "AISight capture",
        "url": "index.html?overlay=1",
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": true,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Pictures/AISight/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
